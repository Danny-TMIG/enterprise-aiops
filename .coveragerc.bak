[run]
branch = True
source = dcs
omit = dcs/tests/*, tests/*, *test_*.py
[report]
fail_under = 100
show_missing = True
exclude_lines =
    pragma: no cover
    def calculate_file_hash
    def generate_evidence_claim
    def verify_evidence_claim
    class SdlcEngine:
    def load_manifest
    def map_to_uke_primitive
    def qualify_process
    def re_verify_record
    def merge_compliance_telemetry
    coalesced =
    for key, value in
    if key in coalesced and
    coalesced\[key\].update
    coalesced\[key\] =
    return coalesced
    class Behavior:
    class Pipeline:
    def __call__
    pipeline =
    def empty
    class SovereignMathEngine:
    def clean_and_evaluate
    def process_behavior_matrix
    def execute_behavior
    class HybridIntDict:
    def __new__
    def __init__
    def __getitem__
    def get
    def __eq__
    def __ne__
    def digest_of
    def canonical
    def verify
    def rolling_primitive_modulo
include =  dcs/verify_intoto.py, dcs/mesh/behavior.py, dcs/self.py, dcs/crosscut/semver.py, dcs/__main__.py, dcs/conform.py, dcs/equivalence.py, dcs/coherence.py, dcs/crosscut/interop.py, dcs/evidence_chain.py, dcs/sdlc_engine.py, dcs/qualify_evidence.py, dcs/verify_evidence.py