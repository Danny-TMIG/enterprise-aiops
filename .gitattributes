# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Explicitly binary files that must not be normalized.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.so binary
*.dylib binary
*.pyd binary
*.mmap binary
*.db binary

# Source files always LF.
*.py   text eol=lf
*.sh   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.css  text eol=lf
*.html text eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.ps1  text eol=crlf
