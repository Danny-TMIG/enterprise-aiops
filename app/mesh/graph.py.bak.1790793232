"""MeshGraph. nodes and edges may be a list or a dict; every
accessor handles both."""
from __future__ import annotations
from typing import Any, Dict, Iterable, List


class MeshGraph:
    def __init__(self, *args, **kwargs):
        self.nodes: List[Any] = []
        self.edges: List[Any] = []

    def add(self, node) -> None:
        self.nodes.append(node)

    def add_edge(self, edge) -> None:
        self.edges.append(edge)

    # ── iteration helpers ───────────────────────────────────────
    def iter_nodes(self) -> Iterable[Any]:
        return self.nodes.values() if isinstance(self.nodes, dict) else iter(self.nodes)

    def iter_edges(self) -> Iterable[Any]:
        return self.edges.values() if isinstance(self.edges, dict) else iter(self.edges)

    def node_by_id(self, nid: str):
        if isinstance(self.nodes, dict):
            return self.nodes.get(nid)
        for n in self.nodes:
            if getattr(n, "id", None) == nid:
                return n
        return None

    def stats(self) -> Dict[str, Any]:
        kinds: Dict[str, int] = {}
        for n in self.iter_nodes():
            k = getattr(n, "kind", "unknown")
            kinds[k] = kinds.get(k, 0) + 1
        return {
            "nodes": len(self.nodes),
            "edges": len(self.edges),
            "kinds": kinds,
        }
