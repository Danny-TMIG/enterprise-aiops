#!/usr/bin/env bash
set -e

PORT=8000
VENV_DIR=".venv"

if lsof -ti:$PORT >/dev/null 2>&1; then
    lsof -ti:$PORT | xargs kill -9 2>/dev/null || true
    sleep 1
fi

if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR"
    "$VENV_DIR/bin/pip" --disable-pip-version-check install --upgrade pip
    "$VENV_DIR/bin/pip" install networkx numpy fastapi uvicorn pydantic mlx mlx-lm
fi

export PYTHON_EXEC="$PWD/$VENV_DIR/bin/python"

exec "$PYTHON_EXEC" -m uvicorn inference_bridge:app --host 127.0.0.1 --port $PORT
