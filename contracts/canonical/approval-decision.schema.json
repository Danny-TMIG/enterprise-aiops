{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asf.gov.approval_decision.v1",
  "title": "ApprovalDecision",
  "type": "object",
  "required": [
    "envelope",
    "approver",
    "decision"
  ],
  "additionalProperties": false,
  "properties": {
    "envelope": {
      "$ref": "common-envelope.schema.json"
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVE",
        "DENY",
        "ESCALATE",
        "ABSTAIN"
      ]
    },
    "reason": {
      "type": "string"
    }
  }
}