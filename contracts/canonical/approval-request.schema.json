{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asf.gov.approval_request.v1",
  "title": "ApprovalRequest",
  "type": "object",
  "required": [
    "envelope",
    "eligible_approvers",
    "context",
    "expiry"
  ],
  "additionalProperties": false,
  "properties": {
    "envelope": {
      "$ref": "common-envelope.schema.json"
    },
    "eligible_approvers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context": {
      "type": "object"
    },
    "quorum": {
      "type": "integer",
      "minimum": 1
    },
    "expiry": {
      "type": "string"
    }
  }
}
