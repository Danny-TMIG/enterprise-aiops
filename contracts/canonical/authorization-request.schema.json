{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asf.gov.authorization_request.v1",
  "title": "AuthorizationRequest",
  "type": "object",
  "required": [
    "envelope",
    "subject",
    "action",
    "object",
    "purpose"
  ],
  "additionalProperties": false,
  "properties": {
    "envelope": {
      "$ref": "common-envelope.schema.json"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "object": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object"
    }
  }
}
