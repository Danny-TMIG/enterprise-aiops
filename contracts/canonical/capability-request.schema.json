{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asf.gov.capability_request.v1",
  "title": "CapabilityRequest",
  "type": "object",
  "required": [
    "envelope",
    "functional_need",
    "requested_by"
  ],
  "additionalProperties": false,
  "properties": {
    "envelope": {
      "$ref": "common-envelope.schema.json"
    },
    "functional_need": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
