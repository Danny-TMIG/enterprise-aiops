{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asf.cmp.execution_evidence.v1",
  "title": "ExecutionEvidence",
  "type": "object",
  "required": [
    "envelope",
    "order_ref",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "envelope": {
      "$ref": "common-envelope.schema.json"
    },
    "order_ref": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_type",
          "assurance"
        ],
        "properties": {
          "claim_type": {
            "type": "string"
          },
          "assurance": {
            "type": "string",
            "enum": [
              "UNVERIFIED",
              "VERIFIED-BOUNDED",
              "INCOMPLETE",
              "CONTRADICTED",
              "EXPIRED",
              "REVOKED"
            ]
          },
          "reference": {
            "type": "string"
          }
        }
      }
    },
    "assurance_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}