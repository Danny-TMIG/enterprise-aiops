{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asf.gov.federation_gateway.v1",
  "title": "ASF Federation Gateway",
  "type": "object",
  "required": ["federation_id", "authority_root", "domains", "flow_decision"],
  "additionalProperties": false,
  "properties": {
    "federation_id": { "type": "string", "minLength": 1 },
    "authority_root": { "type": "string", "minLength": 1 },
    "domains": {
      "type": "array", "minItems": 2,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "flow_decision": {
      "type": "object",
      "required": ["from", "to", "decision"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string" },
        "to":   { "type": "string" },
        "decision": {
          "type": "string",
          "enum": ["ALLOW", "DENY", "REQUIRE_APPROVAL"]
        },
        "data_classes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reason": { "type": "string" },
        "decided_by": { "type": "string" },
        "decided_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
