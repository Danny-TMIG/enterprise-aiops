{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asf.gov.information_flow_decision.v1",
  "title": "InformationFlowDecision",
  "type": "object",
  "required": [
    "envelope",
    "outcome"
  ],
  "additionalProperties": false,
  "properties": {
    "envelope": {
      "$ref": "common-envelope.schema.json"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "CONDITIONAL",
        "ESCALATE",
        "INDETERMINATE"
      ]
    },
    "permitted_representation": {
      "type": "string",
      "enum": [
        "DENIED",
        "METADATA_ONLY",
        "PROVENANCE_ONLY",
        "AGGREGATED",
        "REDACTED",
        "ANONYMIZED",
        "ABSTRACTED",
        "DERIVED",
        "FULL"
      ]
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}