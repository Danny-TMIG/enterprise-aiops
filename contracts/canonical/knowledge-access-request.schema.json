{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asf.cog.knowledge_access_request.v1",
  "title": "KnowledgeAccessRequest",
  "type": "object",
  "required": [
    "envelope",
    "query",
    "purpose"
  ],
  "additionalProperties": false,
  "properties": {
    "envelope": {
      "$ref": "common-envelope.schema.json"
    },
    "query": {
      "type": "object"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}