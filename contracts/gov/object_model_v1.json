{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GovernanceObjectModel",
  "type": "object",
  "required": [
    "object_id",
    "layer",
    "owner",
    "created_at",
    "schema_version"
  ],
  "properties": {
    "object_id": {
      "type": "string",
      "pattern": "^GOV-[A-Z]+-[0-9]+$"
    },
    "layer": {
      "type": "string",
      "enum": [
        "AG",
        "AX",
        "AC"
      ]
    },
    "owner": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_version": {
      "type": "string",
      "default": "1.0.0"
    },
    "metadata": {
      "type": "object"
    },
    "signature": {
      "type": "object",
      "required": [
        "algorithm",
        "public_key",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "Ed25519"
          ]
        },
        "public_key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
