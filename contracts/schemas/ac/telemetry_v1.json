{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ObservationTelemetryEvent",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "node_id",
    "metrics"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "node_id": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "required": [
        "cpu_load_percent",
        "ram_used_bytes",
        "ram_total_bytes"
      ],
      "properties": {
        "cpu_load_percent": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100.0
        },
        "ram_used_bytes": {
          "type": "integer"
        },
        "ram_total_bytes": {
          "type": "integer"
        },
        "mlx_vram_active_bytes": {
          "type": "integer"
        }
      }
    },
    "provenance_hash": {
      "type": "string",
      "description": "SHA-256 omega seal."
    }
  }
}
