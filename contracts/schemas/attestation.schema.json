{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asf.tmig/schemas/attestation.schema.json",
  "title": "T \u2014 Trust artifact (attestation)",
  "type": "object",
  "required": [
    "artifact",
    "produced_by",
    "reads",
    "summary"
  ],
  "properties": {
    "artifact": {
      "const": "attestation"
    },
    "produced_by": {
      "type": "string"
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 4
    },
    "run_id": {
      "type": "string"
    },
    "artifact_root": {
      "type": "string"
    },
    "signer": {
      "type": "string"
    },
    "valid_until": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
