{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asf.tmig/schemas/constraint-binding.schema.json",
  "title": "B \u2014 Constraints artifact (constraint-binding)",
  "type": "object",
  "required": [
    "artifact",
    "produced_by",
    "reads",
    "summary"
  ],
  "properties": {
    "artifact": {
      "const": "constraint-binding"
    },
    "produced_by": {
      "type": "string"
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 4
    },
    "quality": {
      "type": "object"
    },
    "risk": {
      "type": "object"
    },
    "policy": {
      "type": "object"
    },
    "budget": {
      "type": "object"
    },
    "oversight": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
