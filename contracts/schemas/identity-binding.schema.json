{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asf.tmig/schemas/identity-binding.schema.json",
  "title": "I \u2014 Identity artifact (identity-binding)",
  "type": "object",
  "required": [
    "artifact",
    "produced_by",
    "reads",
    "summary"
  ],
  "properties": {
    "artifact": {
      "const": "identity-binding"
    },
    "produced_by": {
      "type": "string"
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 4
    },
    "subject": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "object": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "valid_until": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
