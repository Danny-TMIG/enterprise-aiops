{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asf.tmig/schemas/ledger-entry.schema.json",
  "title": "M \u2014 Ledger artifact (ledger-entry)",
  "type": "object",
  "required": [
    "artifact",
    "produced_by",
    "reads",
    "summary"
  ],
  "properties": {
    "artifact": {
      "const": "ledger-entry"
    },
    "produced_by": {
      "type": "string"
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 4
    },
    "entries": {
      "type": "array"
    },
    "chain_head": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
