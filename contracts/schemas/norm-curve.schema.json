{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asf.tmig/schemas/norm-curve.schema.json",
  "title": "C \u2014 Norm artifact (norm-curve)",
  "type": "object",
  "required": [
    "artifact",
    "produced_by",
    "reads",
    "summary"
  ],
  "properties": {
    "artifact": {
      "const": "norm-curve"
    },
    "produced_by": {
      "type": "string"
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 4
    },
    "median": {
      "type": "number"
    },
    "minimum": {
      "type": "number"
    },
    "maximum": {
      "type": "number"
    },
    "sample_size": {
      "type": "integer",
      "minimum": 0
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  },
  "additionalProperties": true
}
