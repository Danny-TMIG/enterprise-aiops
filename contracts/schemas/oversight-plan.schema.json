{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asf.tmig/schemas/oversight-plan.schema.json",
  "title": "O \u2014 Oversight artifact (oversight-plan)",
  "type": "object",
  "required": [
    "artifact",
    "produced_by",
    "reads",
    "summary"
  ],
  "properties": {
    "artifact": {
      "const": "oversight-plan"
    },
    "produced_by": {
      "type": "string"
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 4
    },
    "level": {
      "enum": [
        "none",
        "notify",
        "approve-before",
        "approve-after",
        "escalate-on-anomaly",
        "continuous"
      ]
    },
    "checkpoints": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
