{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asf.tmig/schemas/provenance-chain.schema.json",
  "title": "P \u2014 Provenance artifact (provenance-chain)",
  "type": "object",
  "required": [
    "artifact",
    "produced_by",
    "reads",
    "summary"
  ],
  "properties": {
    "artifact": {
      "const": "provenance-chain"
    },
    "produced_by": {
      "type": "string"
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 4
    },
    "records": {
      "type": "array"
    },
    "chain_head": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
