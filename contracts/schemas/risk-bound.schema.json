{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asf.tmig/schemas/risk-bound.schema.json",
  "title": "R \u2014 Risk artifact (risk-bound)",
  "type": "object",
  "required": [
    "artifact",
    "produced_by",
    "reads",
    "summary"
  ],
  "properties": {
    "artifact": {
      "const": "risk-bound"
    },
    "produced_by": {
      "type": "string"
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 4
    },
    "ceiling": {
      "type": "string"
    },
    "realized": {
      "type": "string"
    },
    "residual": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
