{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asf.tmig/schemas/routing-handle.schema.json",
  "title": "J \u2014 Handle artifact (routing-handle)",
  "type": "object",
  "required": [
    "artifact",
    "produced_by",
    "reads",
    "summary"
  ],
  "properties": {
    "artifact": {
      "const": "routing-handle"
    },
    "produced_by": {
      "type": "string"
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 4
    },
    "target": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
