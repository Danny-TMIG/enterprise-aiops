{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asf.tmig/schemas/witness-verdict.schema.json",
  "title": "W \u2014 Witness artifact (witness-verdict)",
  "type": "object",
  "required": [
    "artifact",
    "produced_by",
    "reads",
    "summary"
  ],
  "properties": {
    "artifact": {
      "const": "witness-verdict"
    },
    "produced_by": {
      "type": "string"
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 4
    },
    "verdict": {
      "enum": [
        "confirmed",
        "disputed",
        "not-recomputable"
      ]
    },
    "receipt_hash": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
