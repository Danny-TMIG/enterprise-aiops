{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asf.tmig/schemas/yield-report.schema.json",
  "title": "Y \u2014 Yield artifact (yield-report)",
  "type": "object",
  "required": [
    "artifact",
    "produced_by",
    "reads",
    "summary"
  ],
  "properties": {
    "artifact": {
      "const": "yield-report"
    },
    "produced_by": {
      "type": "string"
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 4
    },
    "quality_yield": {
      "type": "number"
    },
    "cost_yield": {
      "type": "number"
    },
    "composite_yield": {
      "type": "number"
    }
  },
  "additionalProperties": true
}
