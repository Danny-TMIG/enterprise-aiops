(* ---- Symbol definitions ---- *)


R___main__.main = ARGS( void ) , RETURNS( Any ) ;

algorithms.Algo = BASE(object) ;
algorithms.GROUPS = CONSTANT ;
algorithms.ALGOS = CONSTANT ;
algorithms.stats = ARGS( void ) , RETURNS( Any ) ;
algorithms.render = ARGS( void ) , RETURNS( Any ) ;
algorithms.save = ARGS( path ) , RETURNS( Any ) ;

apop.State = BASE(object) ;
apop.Death = BASE(object) ;
apop.Population = BASE(object) , METHOD(add) , METHOD(alive) , METHOD(deferred) , METHOD(conflicted) , METHOD(step) , METHOD(run) , METHOD(form) , METHOD(stats) ;
apop.Population_add = ARGS( self , s ) , RETURNS( Any ) ;
apop.Population_alive = ARGS( self ) , RETURNS( Any ) ;
apop.Population_deferred = ARGS( self ) , RETURNS( Any ) ;
apop.Population_conflicted = ARGS( self ) , RETURNS( Any ) ;
apop.Population_step = ARGS( self , sigma , necrotic_ratio , rng ) , RETURNS( Any ) ;
apop.Population_run = ARGS( self , sigma , max_ticks , necrotic_ratio , seed ) , RETURNS( Any ) ;
apop.Population_form = ARGS( self ) , RETURNS( Any ) ;
apop.Population_stats = ARGS( self ) , RETURNS( Any ) ;
apop.sigma_from_triad = ARGS( kernel , spec_for ) , RETURNS( Any ) ;

attest.ROOT = CONSTANT ;
attest.Layer = BASE(object) ;
attest.run_layer = ARGS( name , cmd ) , RETURNS( Layer ) ;
attest.PY = CONSTANT ;
attest.LAYERS = CONSTANT ;
attest.canon = ARGS( obj ) , RETURNS( bytes ) ;
attest.digest_of = ARGS( obj ) , RETURNS( str ) ;
attest.main = ARGS( void ) , RETURNS( Any ) ;

balance.render = ARGS( floor ) , RETURNS( str ) ;
balance.converge = ARGS( floor , max_steps , write ) , RETURNS( str ) ;
balance.report = ARGS( floor ) , RETURNS( str ) ;

bisim.LTS = CONSTANT ;
bisim.bisimilar = ARGS( lts , a , b ) , RETURNS( bool ) ;
bisim.equivalence_classes = ARGS( lts ) , RETURNS( dict_State__int_ ) ;

breadth.compute = ARGS( std_path ) , RETURNS( dict ) ;
breadth.render_matrix = ARGS( std_path ) , RETURNS( str ) ;

build_sdlc_standards.STANDARDS_BODIES = CONSTANT ;
build_sdlc_standards.CATEGORIES = CONSTANT ;
build_sdlc_standards.TARGET = CONSTANT ;
build_sdlc_standards.body_short = ARGS( b ) , RETURNS( Any ) ;
build_sdlc_standards.make_identity = ARGS( standard , body , category ) , RETURNS( Any ) ;

build_standards_registry.ROOT = CONSTANT ;
build_standards_registry.REGISTRY = CONSTANT ;
build_standards_registry.DEFAULT = CONSTANT ;
build_standards_registry.SDLC = CONSTANT ;

certify.LICENSE_VERSION = CONSTANT ;
certify.AUTHORITY = CONSTANT ;
certify.Scope = BASE(object) , METHOD(covers) ;
certify.Scope_covers = ARGS( self , hat ) , RETURNS( bool ) ;
certify.NonClaims = BASE(object) , METHOD(load) ;
certify.NonClaims_load = ARGS( cls ) , RETURNS( NonClaims ) ;
certify.Certification = BASE(object) , METHOD(body) , METHOD(digest) , METHOD(sign) , METHOD(verify) ;
certify.Certification_body = ARGS( self ) , RETURNS( dict ) ;
certify.Certification_digest = ARGS( self ) , RETURNS( str ) ;
certify.Certification_sign = ARGS( self , key ) , RETURNS( Certification ) ;
certify.Certification_verify = ARGS( self , key ) , RETURNS( bool ) ;
