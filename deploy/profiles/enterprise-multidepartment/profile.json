{
  "profile_id": "enterprise-multidepartment",
  "description": "Operations, Finance and Logistics bindings under one enterprise authority; scoped data boundaries and failure modes.",
  "authority_scope": "single-enterprise",
  "federation": true,
  "nodes": [
    {
      "node_id": "dept-operations",
      "domain": "operations",
      "role": "primary",
      "data_boundary": "ops-only",
      "failure_isolation": "hard",
      "cross_domain_flow": "deny-by-default",
      "units": [
        "operations-cell"
      ],
      "unit_id": "operations-cell",
      "component_bindings": [
        "operations-cell"
      ]
    },
    {
      "node_id": "dept-finance",
      "domain": "finance",
      "role": "primary",
      "data_boundary": "finance-only",
      "failure_isolation": "hard",
      "cross_domain_flow": "deny-by-default",
      "units": [
        "finance-cell"
      ],
      "unit_id": "finance-cell",
      "component_bindings": [
        "finance-cell"
      ]
    },
    {
      "node_id": "dept-logistics",
      "domain": "logistics",
      "role": "primary",
      "data_boundary": "logistics-only",
      "failure_isolation": "hard",
      "cross_domain_flow": "deny-by-default",
      "units": [
        "logistics-cell"
      ],
      "unit_id": "logistics-cell",
      "component_bindings": [
        "logistics-cell"
      ]
    },
    {
      "node_id": "enterprise-govern",
      "domain": "govern",
      "role": "authority",
      "data_boundary": "cross-domain-audit-only",
      "failure_isolation": "soft",
      "cross_domain_flow": "govern-mediated",
      "units": [
        "governance-cell"
      ],
      "unit_id": "governance-cell",
      "component_bindings": [
        "governance-cell"
      ]
    },
    {
      "node_id": "federation-gateway",
      "unit_id": "federation-gateway-cell",
      "units": [
        "federation-gateway-cell"
      ],
      "component_bindings": [
        "GOV-FED-001-federation-gateway-and-domain-exchange-coordinator"
      ],
      "role": "authority",
      "failure_isolation": "soft",
      "cross_domain_flow": "govern-mediated"
    }
  ],
  "federation_rules": {
    "max_domains": 3,
    "cross_domain_default": "deny",
    "govern_mediation_required": true,
    "liquid_aperture_required": true,
    "evidence_correlation_required": true,
    "revocation_propagation": "all-nodes",
    "quorum_for_amendment": "govern-only"
  },
  "runtime": {
    "mlx": true,
    "metal": true,
    "neural_engine": true,
    "cpu_only_fallback": true
  },
  "hardware_envelope_per_node": {
    "min_cpu_cores": 8,
    "min_memory_gb": 32,
    "architecture": [
      "arm64",
      "x86_64"
    ],
    "recommended": "Apple M4 Max 16c / 128 GB"
  },
  "unit_map": {
    "operations-cell": "deploy/units/operations-cell",
    "finance-cell": "deploy/units/finance-cell",
    "logistics-cell": "deploy/units/logistics-cell",
    "governance-cell": "deploy/units/governance-cell",
    "federation-gateway-cell": "deploy/units/federation-gateway-cell"
  }
}
