{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asf.deploy.unit.v1",
  "type": "object",
  "required": [
    "unit_id","owner","description","constituent_components",
    "contract_versions","state_owners","dependencies","placement",
    "rollout_policy","profile_bindings","health_checks","resource_limits"
  ],
  "additionalProperties": false,
  "properties": {
    "unit_id":     { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "minLength": 2, "maxLength": 64 },
    "owner":       { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "minLength": 2 },
    "description": { "type": "string", "minLength": 20 },
    "constituent_components": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z]{3}-[A-Z]{3}-[0-9]{3}-" }
    },
    "artifact": {
      "type": "object",
      "required": ["coordinates","status"],
      "additionalProperties": false,
      "properties": {
        "coordinates": { "type": "string", "minLength": 1 },
        "digest":      { "type": ["string","null"] },
        "status":      { "type": "string", "enum": ["declared-not-built","built","sealed","retired"] }
      }
    },
    "contract_versions": {
      "type": "object", "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^asf\\." }
    },
    "state_owners": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z]{3}-[A-Z]{3}-[0-9]{3}-" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "placement": { "type": "string", "minLength": 2 },
    "rollout_policy": { "type": "string", "enum": ["staged","immediate","manual","canary"] },
    "profile_bindings": {
      "type": "array", "minItems": 1,
      "items": { "type": "string" }
    },
    "health_checks": {
      "type": "object",
      "required": ["readiness","liveness"],
      "additionalProperties": false,
      "properties": {
        "readiness": { "type": "string", "pattern": "^/" },
        "liveness":  { "type": "string", "pattern": "^/" }
      }
    },
    "resource_limits": {
      "type": "object",
      "required": ["cpu_cores","memory_gb"],
      "additionalProperties": false,
      "properties": {
        "cpu_cores": { "type": "number", "exclusiveMinimum": 0 },
        "memory_gb": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "secrets":    { "type": "array", "items": { "type": "string" } },
    "migrations": { "type": "array", "items": { "type": "string" } }
  }
}
